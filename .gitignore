# Создать полный .gitignore
cat > .gitignore << 'EOF'
# PyCharm
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store
*.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media and static
media/
staticfiles/

# Testing
.coverage
htmlcov/
.pytest_cache/
EOF

